<Window x:Class="KBEA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KBEA.App.ViewModels"
        xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="知识库自进化助手 · 开源版" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Background="{DynamicResource PanelBackground}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                <Border Width="30" Height="30" Background="{DynamicResource AccentBrush}" CornerRadius="7">
                    <TextBlock Text="知" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Margin="9,0,0,0" Text="知识库自进化助手" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Margin="7,0,0,0" Text="{Binding Version}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <TabControl Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="6,5,0,0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <TabPanel IsItemsHost="True" />
                        </ScrollViewer>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Title}" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                            <Button Content="×" FontSize="15" Padding="4,0" Margin="8,0,0,0" BorderThickness="0" Background="Transparent"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="关闭标签" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding NewTabCommand}" ToolTip="新建选项卡（Ctrl+T）" Content="＋" FontSize="20" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="切换亮/暗主题" Content="◐" FontSize="18" />
                <Button Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" ToolTip="账号与设置" Content="⚙" FontSize="17" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="260" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsSidebarVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBackground}" Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="14,10,14,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Width="30" Height="30"><TextBlock Text="👤" HorizontalAlignment="Center" /></Border>
                            <TextBlock Margin="9,0,0,0" Text="{Binding Configuration.AuthorName}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="设置" Padding="7,3" Command="{Binding SettingsCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="工作空间" Command="{Binding ShowWorkspaceSidebarCommand}" Padding="8,6" Margin="0,0,3,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsWorkspaceSidebar}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="本地目录" Command="{Binding ShowLocalSidebarCommand}" Padding="8,6" Margin="3,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsLocalSidebar}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2" Visibility="{Binding IsWorkspaceSidebar, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel Margin="10,0,10,8">
                            <Button Content="＋ 空间" Style="{StaticResource ToolbarButton}" Command="{Binding NewWorkspaceCommand}" />
                            <Button Content="▣ 挂接文件夹" Style="{StaticResource ToolbarButton}" Command="{Binding MountFolderCommand}" />
                            <Button Content="＋ 分类" Style="{StaticResource ToolbarButton}" Command="{Binding AddCategoryCommand}" />
                            <Button Content="◫ 编入分类" Style="{StaticResource ToolbarButton}" Command="{Binding AssignCategoryCommand}" />
                            <Button Content="导出编目" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCatalogCommand}" />
                        </WrapPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,8,8">
                                <TextBlock Text="空间与分类" Margin="8,0,4,6" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TreeView x:Name="WorkspaceTree" ItemsSource="{Binding Workspaces}" SelectedItemChanged="WorkspaceTree_SelectedItemChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <TextBlock Text="{Binding Icon}" Width="22" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{DynamicResource WarningBrush}" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" Visibility="{Binding Badge, Converter={StaticResource StringToVisibility}}">
                                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9" />
                                                </Border>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="解挂当前文件夹（保留数据）" Margin="14,6,14,12" Command="{Binding UnmountCommand}" />
                    </Grid>
                    <Grid Grid.Row="2" Visibility="{Binding IsLocalSidebar, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="10,0,10,8">
                            <Button Content="＋ 打开目录" Style="{StaticResource ToolbarButton}" Command="{Binding OpenLocalFolderCommand}" />
                            <Button Content="↻ 驱动器" Style="{StaticResource ToolbarButton}" Command="{Binding RefreshLocalFoldersCommand}" />
                            <Button Content="☆ 收藏" Style="{StaticResource ToolbarButton}" Command="{Binding AddFavoriteCommand}" />
                        </StackPanel>
                        <TreeView Grid.Row="1" x:Name="LocalTree" ItemsSource="{Binding LocalFolders}" SelectedItemChanged="LocalTree_SelectedItemChanged" Margin="8,0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <EventSetter Event="TreeViewItem.Expanded" Handler="LocalNode_Expanded" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="▰" Foreground="{DynamicResource WarningBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" /></StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <Border Grid.Row="2" Margin="10,8" Padding="8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" MaxHeight="150">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="收藏目录" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding Favorites}" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,2">
                                                <TextBlock Text="{Binding}" MaxWidth="195" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <Grid Grid.Column="2" Margin="12">
                <Grid Visibility="{Binding IsBrowserView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="←" Style="{StaticResource IconButton}" Command="{Binding SelectedTab.BackCommand}" ToolTip="后退" />
                            <Button Content="→" Style="{StaticResource IconButton}" Command="{Binding SelectedTab.ForwardCommand}" ToolTip="前进" />
                            <Button Content="↑" Style="{StaticResource IconButton}" Command="{Binding SelectedTab.UpCommand}" ToolTip="上级目录" />
                            <Button Content="↻" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="刷新" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SelectedTab.AddressText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Address_KeyDown" Margin="4,0" VerticalAlignment="Center" ToolTip="输入目录路径后按 Enter 跳转" />
                        <Grid Grid.Column="2" Margin="4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedTab.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索空间索引或本地目录中的文件名" />
                            <Button Grid.Column="1" Content="🔍" Width="34" Padding="0" Command="{Binding SelectedTab.SearchCommand}" />
                        </Grid>
                        <Button Grid.Column="3" Content="◧ 预览" Style="{StaticResource IconButton}" Command="{Binding SelectedTab.TogglePreviewCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Content="⇩ 拉取更新" Style="{StaticResource ToolbarButton}" Command="{Binding PullCommand}" />
                            <Button Content="⇧ 保存并上传" Style="{StaticResource ToolbarButton}" Command="{Binding SavePushCommand}" />
                            <Button Content="◷ Git 历史" Style="{StaticResource ToolbarButton}" Command="{Binding HistoryCommand}" />
                            <Button Content="⚙ Git 绑定" Style="{StaticResource ToolbarButton}" Command="{Binding BindGitCommand}" />
                            <Button Content="★ 关键节点" Style="{StaticResource ToolbarButton}" Command="{Binding ArchiveCommand}" />
                            <Button Content="▤ 归档记录" Style="{StaticResource ToolbarButton}" Command="{Binding ArchiveHistoryCommand}" />
                        </WrapPanel>
                        <ProgressBar Grid.Column="1" Width="90" Height="4" Margin="8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Grid Grid.Row="2" Background="{DynamicResource PanelBackground}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" MinWidth="150"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                            <TreeView x:Name="FolderTree" ItemsSource="{Binding SelectedTab.Directories}" SelectedItemChanged="FolderTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <EventSetter Event="TreeViewItem.Expanded" Handler="FolderNode_Expanded" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="▰" Foreground="{DynamicResource WarningBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" /></StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />
                        <DataGrid Grid.Column="2" ItemsSource="{Binding SelectedTab.Files}" SelectedItem="{Binding SelectedTab.SelectedFile, Mode=TwoWay}" MouseDoubleClick="Files_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70" />
                                <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="85" />
                                <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime, StringFormat=MM-dd HH:mm}" Width="110" />
                                <DataGridTextColumn Header="Git" Binding="{Binding GitState}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="3" Width="310" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding SelectedTab.IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="预览" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding SelectedTab.SelectedFile.Name}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <TextBox Text="{Binding SelectedTab.PreviewText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Visibility="{Binding SelectedTab.HasTextPreview, Converter={StaticResource BoolToVisibility}}" />
                                    <Image Source="{Binding SelectedTab.PreviewImage}" Stretch="Uniform" Visibility="{Binding SelectedTab.HasImagePreview, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsEmptyView, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource PanelBackground}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="从一个目录或工作空间开始" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Margin="0,12,0,22" Text="默认不创建任何工作空间。你可以直接浏览本地目录，或按需创建空间并挂接资料文件夹。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="＋ 新建工作空间" Style="{StaticResource PrimaryButton}" Command="{Binding NewWorkspaceCommand}" Margin="6" />
                            <Button Content="▰ 打开本地目录" Command="{Binding OpenLocalFolderCommand}" Margin="6" Padding="16,7" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsCatalogView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,4,2,16">
                        <TextBlock Text="跨文件夹编目视图" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CatalogTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CatalogResults}" SelectedItem="{Binding SelectedCatalogResult, Mode=TwoWay}" MouseDoubleClick="Catalog_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="挂载文件夹" Binding="{Binding MountName}" Width="160" />
                            <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" />
                            <DataGridTextColumn Header="物理位置" Binding="{Binding FullPath}" Width="2*" />
                            <DataGridTextColumn Header="文件指纹" Binding="{Binding FileHash}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border x:Name="AssistantHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,18">
                    <Grid>
                        <controls:Thumb x:Name="AssistantButton" DragDelta="AssistantThumb_DragDelta" ToolTip="浮动助手（可拖动）">
                            <controls:Thumb.Template>
                                <ControlTemplate TargetType="controls:Thumb">
                                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentBrush}" Cursor="Hand">
                                        <TextBlock Text="✦" FontSize="25" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </controls:Thumb.Template>
                        </controls:Thumb>
                        <Popup PlacementTarget="{Binding ElementName=AssistantButton}" IsOpen="{Binding IsAssistantOpen, Mode=TwoWay}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="320" Height="420" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✦ 知识助手" FontSize="17" FontWeight="SemiBold" />
                                        <Button HorizontalAlignment="Right" Content="×" Background="Transparent" BorderThickness="0" Command="{Binding ToggleAssistantCommand}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="◌" FontSize="54" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding PluginSummary}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,14,0,6" />
                                        <TextBlock Text="开源核心可独立使用。接入助手插件后，这里将显示对话与知识检索能力。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                    <TextBox Grid.Row="2" IsEnabled="False" Text="智能服务未启用" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding GlobalStatus}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SelectedTab.GitStatus.Display}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedTab.SyncText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="锁：无  │  自动：提示模式" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
