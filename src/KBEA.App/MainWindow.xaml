<Window x:Class="KBEA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KBEA.App.ViewModels"
        xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:toolbar="clr-namespace:KBEA.App.Controls"
        xmlns:core="clr-namespace:KBEA.Core.Plugins;assembly=KBEA.Core"
        xmlns:helpers="clr-namespace:KBEA.App.Helpers"
        Title="{Binding WindowTitle}" Width="1440" Height="900" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None"
        Background="Transparent" AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,1,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}" />
    </Window.InputBindings>
    <Border x:Name="RootShell" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Background="{DynamicResource SidebarBackground}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                <Image x:Name="BrandLogo" Source="Assets/logo.png" Width="30" Height="30" Stretch="Uniform" />
                <TextBlock Margin="9,0,0,0" Text="{Binding ProductName}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Margin="7,0,0,0" Text="{Binding Version}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <DockPanel Grid.Column="1" VerticalAlignment="Bottom" LastChildFill="True">
                <TabControl x:Name="MainTabs" ItemsSource="{Binding TabItems}" SelectedItem="{Binding SelectedTabItem, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="0" Height="44" VerticalAlignment="Bottom"
                            AllowDrop="True" PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" PreviewMouseMove="Tab_PreviewMouseMove" PreviewMouseWheel="Tabs_PreviewMouseWheel" SelectionChanged="Tabs_SelectionChanged" DragOver="Tab_DragOver" Drop="Tab_Drop">                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Border Background="Transparent">
                                <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <TabPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Width" Value="36" />
                                    <Setter Property="MaxWidth" Value="36" />
                                    <Setter Property="AutomationProperties.Name" Value="新建选项卡" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding CurrentPath, Converter={StaticResource FileIconConverter}}" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- 来源标记：空间 / 本地 / 远程 -->
                                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding SourceTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="compact">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="×" FontSize="16" Width="25" Height="25" Padding="0" Margin="2,0,0,0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="关闭标签">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="compact">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.ColumnSpan="5" Content="＋" FontSize="20" Width="36" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.NewTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="新建选项卡（Ctrl+T）" AutomationProperties.Name="新建选项卡">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </DockPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" ToolTip="账号与设置" AutomationProperties.Name="账号与设置">
                    <Image x:Name="IconSettings" Source="{toolbar:ToolbarIconSource Image=Settings}" Width="16" Height="16" />
                </Button>
                <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="5,0" />
                <Button Style="{StaticResource IconButton}" ToolTip="最小化" Content="—" Width="42" Click="Minimize_Click" />
                <Button Style="{StaticResource IconButton}" ToolTip="最大化或还原" Content="□" Width="42" Click="Maximize_Click" />
                <Button Style="{StaticResource IconButton}" ToolTip="关闭" Content="×" FontSize="18" Width="46" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBackground}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="260" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="10,10,10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ToggleButton Content="工作空间" Command="{Binding ShowWorkspaceSidebarCommand}" IsChecked="{Binding IsWorkspaceSidebar, Mode=OneWay}" Style="{StaticResource SidebarTabButton}" Margin="0,0,3,0" />
                        <ToggleButton Grid.Column="1" Content="本地目录" Command="{Binding ShowLocalSidebarCommand}" IsChecked="{Binding IsLocalSidebar, Mode=OneWay}" Style="{StaticResource SidebarTabButton}" Margin="3,0" />
                        <ToggleButton Grid.Column="2" Content="团队共享" Command="{Binding ShowRemoteSidebarCommand}" IsChecked="{Binding IsRemoteSidebar, Mode=OneWay}" Style="{StaticResource SidebarTabButton}" Margin="3,0,0,0" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4" Margin="10,4,10,4" Visibility="{Binding IsWorkspaceSidebar, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button AutomationProperties.Name="新建空间" Content="▣ 空间" Style="{StaticResource ToolbarButton}" Command="{Binding NewSpaceCommand}" ToolTip="新建空间：一个空间对应一个物理位置" Padding="4,5" Margin="0" />
                            <Button Grid.Column="1" Content="◫ 目录" Style="{StaticResource ToolbarButton}" Command="{Binding NewDirectoryCommand}" ToolTip="新建目录：把空间逻辑归类" Padding="4,5" Margin="0" />
                            <Button Grid.Column="2" Content="⌫ 删除" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteNodeCommand}" ToolTip="删除选中的空间或目录" Padding="4,5" Margin="0" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Visibility="{Binding IsWorkspaceSidebar, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer helpers:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="WorkspaceTreeArea_PreviewMouseLeftButtonDown">
                            <StackPanel Margin="8,0,8,8">
                                <TreeView x:Name="WorkspaceTree" ItemsSource="{Binding Workspaces}" SelectedItemChanged="WorkspaceTree_SelectedItemChanged" AllowDrop="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseLeftButtonDown="WorkspaceTree_PreviewMouseLeftButtonDown" PreviewMouseMove="WorkspaceTree_PreviewMouseMove_Drag"
                                          DragOver="WorkspaceTree_DragOver" Drop="WorkspaceTree_Drop" MouseDoubleClick="WorkspaceTree_MouseDoubleClick">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Grid MinWidth="175">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Width="24" FontSize="17" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="2" Background="{DynamicResource WarningBrush}" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" Visibility="{Binding Badge, Converter={StaticResource StringToVisibility}}">
                                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9" />
                                                </Border>
                                                <Button Grid.Column="3" Content="◈" Style="{StaticResource IconButton}" FontSize="13" Padding="3,0" Margin="3,0,0,0" ToolTip="查看该知识库的元数据构建情况" Visibility="{Binding IsSpace, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.ShowSpaceMetadataCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="4" Content="✎" Style="{StaticResource IconButton}" FontSize="15" Padding="3,0" Margin="3,0,0,0" ToolTip="编辑空间（重命名 / 重新绑定位置）" Visibility="{Binding IsSpace, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditSpaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="4" Content="✎" Style="{StaticResource IconButton}" FontSize="15" Padding="3,0" Margin="3,0,0,0" ToolTip="重命名目录" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.EditDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Visibility="{Binding IsLocalSidebar, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer helpers:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0">
                                <ToggleButton x:Name="QuickGroup" Content="常用位置" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <ListBox x:Name="QuickList" ItemsSource="{Binding QuickFolders}" Visibility="{Binding IsChecked, ElementName=QuickGroup, Converter={StaticResource BoolToVisibility}}" SelectionChanged="LocalLocationList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="23,5" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Converter={StaticResource FileIconConverter}}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,8" />
                                <ToggleButton x:Name="RecentGroup" Content="最近访问" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <ListBox x:Name="RecentList" ItemsSource="{Binding RecentFolders}" Visibility="{Binding IsChecked, ElementName=RecentGroup, Converter={StaticResource BoolToVisibility}}" SelectionChanged="LocalLocationList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="23,5" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}"><Image Source="{Binding Converter={StaticResource FileIconConverter}}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,8" />
                                <ToggleButton x:Name="ComputerGroup" Content="我的电脑" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <TreeView x:Name="LocalTree" ItemsSource="{Binding LocalFolders}" Visibility="{Binding IsChecked, ElementName=ComputerGroup, Converter={StaticResource BoolToVisibility}}" SelectedItemChanged="LocalTree_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><EventSetter Event="TreeViewItem.Expanded" Handler="LocalNode_Expanded" /><EventSetter Event="TreeViewItem.Selected" Handler="LocalTree_ItemSelected" /></Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Margin="0,3"><Image Source="{Binding Converter={StaticResource FileIconConverter}}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" /></StackPanel></HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,8" />
                                <ToggleButton x:Name="FavoriteGroup" Content="收藏" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <ListBox x:Name="FavoriteList" ItemsSource="{Binding Favorites}" Visibility="{Binding IsChecked, ElementName=FavoriteGroup, Converter={StaticResource BoolToVisibility}}" SelectionChanged="FavoriteList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="23,5" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding}"><Image Source="{Binding Converter={StaticResource FileIconConverter}}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Path=., Converter={StaticResource FolderNameConverter}}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,8" />
                                <ToggleButton x:Name="RemoteGroup" Content="网络位置" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <ListBox x:Name="RemoteListInLocal" ItemsSource="{Binding RemoteLocations}" Visibility="{Binding IsChecked, ElementName=RemoteGroup, Converter={StaticResource BoolToVisibility}}" SelectionChanged="RemoteList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="23,5" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Address}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="5,1" Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Address}" MaxWidth="205" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Visibility="{Binding IsRemoteSidebar, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4" Margin="10,4,10,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="👥 团队管理" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Command="{Binding ShowTeamManagerCommand}" ToolTip="新建团队 / 加入团队 / 管理共享与权限" />
                                <Button Content="↻ 同步团队" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="8,0,0,0" Command="{Binding RefreshTeamCommand}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" helpers:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0">
                                <StackPanel.Resources>
                                    <!-- 行悬浮高亮样式（团队/成员/空间行共用） -->
                                    <Style x:Key="TeamShareRowBorder" TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="CornerRadius" Value="4" />
                                        <Setter Property="Padding" Value="4,3" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <!-- 团队共享树节点模板：团队 → 有共享的成员 → 该成员共享的空间 -->
                                    <DataTemplate x:Key="TeamShareNodeTemplate">
                                        <StackPanel Margin="2,6,0,2" ToolTip="{Binding TeamId}">
                                            <Border Style="{StaticResource TeamShareRowBorder}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="104" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MemberSummary}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Members}" Margin="16,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2,0,0" ToolTip="{Binding StatusText}">
                                                            <Border Style="{StaticResource TeamShareRowBorder}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding StatusDot}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Nickname}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="130" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Shares}" Margin="14,1,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,1" ToolTip="{Binding ToolTip}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Cursor="Hand"
                                                                                    MouseLeftButtonDown="SharedSpace_MouseLeftButtonDown">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border" BasedOn="{StaticResource TeamShareRowBorder}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Entry.SpaceName}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="106"
                                                                                               VerticalAlignment="Center" FontWeight="{Binding RowWeight}" Opacity="{Binding RowOpacity}" />
                                                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding LevelText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Button Grid.Column="1" Content="＋我的" Style="{StaticResource IconButton}" FontSize="11" Padding="4,0" Margin="2,0,0,0"
                                                                                    ToolTip="添加到我的工作空间（团队引用空间，不再共享）"
                                                                                    Command="{Binding DataContext.AddSharedToWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </StackPanel.Resources>
                                <ToggleButton Content="我的团队" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <ItemsControl ItemsSource="{Binding MyTeamTree}" Margin="0,0,0,10" ItemTemplate="{StaticResource TeamShareNodeTemplate}" />
                                <ToggleButton Content="加入的团队" IsChecked="True" Style="{StaticResource SidebarGroupHeader}" />
                                <ItemsControl ItemsSource="{Binding JoinedTeamTree}" Margin="0,0,0,6" ItemTemplate="{StaticResource TeamShareNodeTemplate}" />
                                <TextBlock Text="还未加入其他团队" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,4,0,6"
                                           Visibility="{Binding JoinedTeamEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <ToggleButton x:Name="RemoteGroupShared" Content="网络位置（Git / rsync）" IsChecked="False" Style="{StaticResource SidebarGroupHeader}" />
                                <ListBox x:Name="RemoteListInShared" ItemsSource="{Binding RemoteLocations}" Visibility="{Binding IsChecked, ElementName=RemoteGroupShared, Converter={StaticResource BoolToVisibility}}" SelectionChanged="RemoteList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="6,5" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="单击打开此远程目录的本地副本或缓存">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="5,1" Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Address}" MaxWidth="205" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- 浏览区：地址栏/工具栏在浏览与检索结果两种状态下都保留，检索结果嵌在文件列表位置 -->
                <Grid Visibility="{Binding IsBrowserChromeVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="收起或展开左侧栏（Ctrl+B）"
                                    AutomationProperties.Name="收起或展开左侧栏">
                                <Image x:Name="IconSidebar" Source="{toolbar:ToolbarIconSource Image=Sidebar}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding SelectedTab.BackCommand}" ToolTip="后退" AutomationProperties.Name="后退">
                                <Image x:Name="IconBack" Source="{toolbar:ToolbarIconSource Image=Back}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding SelectedTab.ForwardCommand}" ToolTip="前进" AutomationProperties.Name="前进">
                                <Image x:Name="IconForward" Source="{toolbar:ToolbarIconSource Image=Forward}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding SelectedTab.UpCommand}" ToolTip="上级目录" AutomationProperties.Name="上级目录">
                                <Image x:Name="IconUp" Source="{toolbar:ToolbarIconSource Image=Up}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="刷新" AutomationProperties.Name="刷新">
                                <Image x:Name="IconRefresh" Source="{toolbar:ToolbarIconSource Image=Refresh}" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                        <!-- 检索结果态显示结果归属位置，浏览态显示可编辑地址 -->
                        <TextBlock Grid.Column="1" Text="{Binding SearchAddressText}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"
                                   Visibility="{Binding IsSearchView, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Grid.Column="1" Height="30" Text="{Binding SelectedTab.AddressText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Address_KeyDown" Margin="4,0" VerticalAlignment="Center" ToolTip="输入目录路径后按 Enter 跳转"
                                 Visibility="{Binding IsBrowserView, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Grid.Column="2" Height="30" Margin="4,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding KnowledgeSearch.Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="KnowledgeSearch_KeyDown"
                                     ToolTip="语义检索：支持“今年8月左右的30页左右的ppt”这类描述（回车检索）" />
                            <Button Grid.Column="1" Width="34" Padding="0" Command="{Binding KnowledgeSearchCommand}" ToolTip="语义检索（回车）" AutomationProperties.Name="语义检索">
                                <Image x:Name="IconSearch" Source="{toolbar:ToolbarIconSource Image=Search}" Width="16" Height="16" />
                            </Button>
                            <Button Grid.Column="2" Content="✕ 清除结果" Margin="6,0,0,0" Padding="10,0" Command="{Binding KnowledgeSearch.ClearCommand}"
                                    ToolTip="清除检索结果，回到当前文件夹浏览"
                                    Visibility="{Binding IsSearchView, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding SelectedTab.TogglePreviewCommand}" ToolTip="显示或隐藏右侧预览面板" AutomationProperties.Name="预览">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="IconPreview" Source="{toolbar:ToolbarIconSource Image=Preview}" Width="16" Height="16" />
                                <TextBlock Text="预览" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid x:Name="ToolbarHost" SizeChanged="ToolbarHost_SizeChanged">
                            <DockPanel x:Name="ToolbarPanel" HorizontalAlignment="Left">
                                <!-- 溢出按钮放最右侧 -->
                                <ToggleButton x:Name="ToolbarOverflowButton" DockPanel.Dock="Right" Style="{StaticResource IconToggleButton}" Content="⋮" FontSize="16" Width="28" Height="28" Padding="0" Visibility="Collapsed" ToolTip="更多工具" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                                <!-- 内置工具组（收藏/编目）：框架按组渲染，放不下时整组收起为首按钮+下拉 -->
                                <ContentControl x:Name="BuiltinToolbarGroup" DockPanel.Dock="Left" />
                                <!-- 插件工具组：插件只声明图标/提示/命令，分组与收起由框架负责 -->
                                <ItemsControl x:Name="PluginToolbarGroupsHost" DockPanel.Dock="Left" ItemsSource="{Binding PluginToolbarGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 每个插件组前置一条竖向分隔线：与内置组及相邻插件组之间形成视觉分组 -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="1" Height="18" Margin="5,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource BorderBrush}" />
                                                <toolbar:ToolbarGroupControl />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <Popup x:Name="ToolbarOverflow" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=ToolbarOverflowButton}" IsOpen="{Binding IsChecked, ElementName=ToolbarOverflowButton, Mode=TwoWay}">
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,0,0" MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ToolbarOverflowPanel" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ProgressBar Grid.Column="1" Width="90" Height="4" Margin="8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <!-- 文件列表（检索结果态隐藏，由下方检索结果面板覆盖同一格） -->
                    <Grid Grid.Row="2" Background="{DynamicResource PanelBackground}"
                          Visibility="{Binding IsBrowserView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="FilesDataGrid" ItemsSource="{Binding SelectedTab.Files}" SelectedItem="{Binding SelectedTab.SelectedFile, Mode=TwoWay}" MouseDoubleClick="Files_MouseDoubleClick"
                                  SelectionMode="Extended" SelectionChanged="FilesDataGrid_SelectionChanged"
                                  AllowDrop="True" DragOver="FilesDataGrid_DragOver" Drop="FilesDataGrid_Drop" PreviewMouseLeftButtonDown="FilesDataGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FilesDataGrid_PreviewMouseMove">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开" Command="{Binding SelectedTab.OpenCommand}" InputGestureText="Enter" />
                                    <Separator />
                                    <MenuItem Header="复制" Command="{Binding SelectedTab.CopyCommand}" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="剪切" Command="{Binding SelectedTab.CutCommand}" InputGestureText="Ctrl+X" />
                                    <MenuItem Header="粘贴" Command="{Binding SelectedTab.PasteCommand}" InputGestureText="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="重命名" Command="{Binding SelectedTab.RenameCommand}" InputGestureText="F2" />
                                    <MenuItem Header="删除（放回收站）" Command="{Binding SelectedTab.DeleteCommand}" InputGestureText="Delete" />
                                    <MenuItem Header="永久删除" Command="{Binding SelectedTab.PermanentDeleteCommand}" InputGestureText="Shift+Delete" />
                                    <Separator />
                                    <MenuItem Header="在文件资源管理器中显示" Command="{Binding SelectedTab.ShowInExplorerCommand}" />
                                    <MenuItem Header="打开方式…" Command="{Binding SelectedTab.OpenWithCommand}" />
                                    <Separator />
                                    <MenuItem Header="全选" Click="FilesSelectAll_Click" InputGestureText="Ctrl+A" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="名称" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Converter={StaticResource FileIconConverter}}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70" />
                                <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="85" />
                                <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime, StringFormat=MM-dd HH:mm}" Width="110" />
                                <DataGridTextColumn Header="Git" Binding="{Binding GitState}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="4,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="Git 状态：新增 / 已修改 / 已删除 / 重命名 / 冲突" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GitState}" Value="冲突">
                                                    <Setter Property="Foreground" Value="#E05252" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="ToolTip" Value="该文件存在合并冲突，选中后点击「⚖ 版本比对」解决" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Width="310" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding SelectedTab.IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <!-- Row 0: 文件元数据 -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="详情" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="名称" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTab.SelectedFile.Name, FallbackValue=—}" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Text="类型" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTab.SelectedFile.Kind, FallbackValue=—}" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Text="大小" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTab.SelectedFile.DisplaySize, FallbackValue=—}" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Text="创建" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTab.SelectedFile.CreationTime, StringFormat=yyyy-MM-dd HH:mm, FallbackValue=—}" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Text="修改" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTab.SelectedFile.LastWriteTime, StringFormat=yyyy-MM-dd HH:mm, FallbackValue=—}" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Text="路径" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTab.SelectedFile.FullPath, FallbackValue=—}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <!-- P4：插件动态字段（IMetadataFieldContribution 追加在 6 个内置行之后） -->
                                        <ItemsControl Grid.Row="6" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedTab.PluginFields}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,10,2"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                                <!-- Row 1: 预览渲染器 -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="预览" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="6">
                                        <Grid>
                                            <TextBox Text="{Binding SelectedTab.PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Visibility="{Binding SelectedTab.HasTextPreview, Converter={StaticResource BoolToVisibility}}" />
                                            <Image Source="{Binding SelectedTab.PreviewImage}" Stretch="Uniform" Visibility="{Binding SelectedTab.HasImagePreview, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 检索结果面板（嵌入浏览界面：地址栏/搜索栏/预览保留在原位） -->
                <Grid Grid.Row="2" Visibility="{Binding IsSearchView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,2,2,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="语义检索" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding KnowledgeSearch.ResultTitle}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding KnowledgeSearch.Understanding}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.4*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：命中文件列表 -->
                        <ListBox ItemsSource="{Binding KnowledgeSearch.Hits}" SelectedItem="{Binding KnowledgeSearch.SelectedHit, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,6,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding Converter={StaticResource FileIconConverter}}" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Score}" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" ToolTip="相关度评分" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Content="打开" Style="{StaticResource IconButton}" Command="{Binding DataContext.KnowledgeSearch.OpenHitCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                <Button Content="所在文件夹" Style="{StaticResource IconButton}" Command="{Binding DataContext.KnowledgeSearch.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="新标签页定位到该文件所在文件夹" />
                                                <Button Content="⌄" Style="{StaticResource IconButton}" Command="{Binding DataContext.KnowledgeSearch.ToggleSiblingsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding HasSiblings, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding SiblingSummary}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding RelativePath}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="{Binding Summary}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2" />
                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding TagChips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="6,1" Margin="0,2,5,2" ToolTip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Display}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- 历史版本展开区（独立行，不与标签重叠） -->
                                        <ItemsControl Grid.Row="4" ItemsSource="{Binding Siblings}" Margin="22,4,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="·" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding FileName}" FontSize="12" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="Transparent" Margin="0,0,2,6" />

                        <!-- 右：选中文件详情 + 预览 -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding KnowledgeSearch.SelectedHit.FileName}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14" />
                                    <TextBlock Text="{Binding KnowledgeSearch.SelectedInfo}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,4" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KnowledgeSearch.SelectedHit.RelativePath}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding KnowledgeSearch.SelectedHit.TagChips}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="7,2" Margin="0,0,5,4" ToolTip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Display}" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="打 开" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding KnowledgeSearch.OpenHitCommand}" CommandParameter="{Binding KnowledgeSearch.SelectedHit}" />
                                        <Button Content="所在文件夹" Margin="8,0,0,0" Padding="16,7"
                                                Command="{Binding KnowledgeSearch.OpenFolderCommand}" CommandParameter="{Binding KnowledgeSearch.SelectedHit}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource PanelBackground}" CornerRadius="4" Padding="6">
                                    <Grid>
                                        <TextBox Text="{Binding KnowledgeSearch.PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                                 Visibility="{Binding KnowledgeSearch.HasTextPreview, Converter={StaticResource BoolToVisibility}}" />
                                        <Image Source="{Binding KnowledgeSearch.PreviewImage}" Stretch="Uniform"
                                               Visibility="{Binding KnowledgeSearch.HasImagePreview, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 空结果提示 -->
                    <TextBlock Grid.Row="1" Text="没有匹配结果。可调整描述，或在「◈ 知识WIKI」中重新构建标签与描述。" Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16"
                               Visibility="{Binding KnowledgeSearch.HasResult, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=Inverse}" />
                </Grid>

                <Grid Visibility="{Binding IsEmptyView, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource PanelBackground}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="从一个目录或工作空间开始" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Margin="0,12,0,22" Text="默认不创建任何内容。空间对应一个物理位置（本地、Git、rsync 或网络），目录用于把空间逻辑归类。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="＋ 新建空间" Style="{StaticResource PrimaryButton}" Command="{Binding NewSpaceCommand}" Margin="6" />
                            <Button Content="◫ 新建目录" Command="{Binding NewDirectoryCommand}" Margin="6" Padding="16,7" />
                            <Button Content="▰ 打开本地目录" Command="{Binding OpenLocalFolderCommand}" Margin="6" Padding="16,7" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 目录编目视图：独占整个内容区（chrome 隐藏），显示当前目录的编目信息 -->
                <Grid Visibility="{Binding IsCatalogView, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource PanelBackground}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,4,2,16">
                        <TextBlock Text="目录编目视图" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CatalogTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CatalogResults}" SelectedItem="{Binding SelectedCatalogResult, Mode=TwoWay}" MouseDoubleClick="Catalog_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="所属空间" Binding="{Binding SpaceName}" Width="160" />
                            <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="90" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteText}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border x:Name="AssistantHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,18">
                    <Grid>
                        <controls:Thumb x:Name="AssistantButton" DragDelta="AssistantThumb_DragDelta" ToolTip="浮动助手（可拖动）">
                            <controls:Thumb.Template>
                                <ControlTemplate TargetType="controls:Thumb">
                                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentBrush}" Cursor="Hand">
                                        <TextBlock Text="✦" FontSize="25" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </controls:Thumb.Template>
                        </controls:Thumb>
                        <Popup PlacementTarget="{Binding ElementName=AssistantButton}" IsOpen="{Binding IsAssistantOpen, Mode=TwoWay}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="320" Height="420" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✦ 知识助手" FontSize="17" FontWeight="SemiBold" />
                                        <Button HorizontalAlignment="Right" Content="×" Background="Transparent" BorderThickness="0" Command="{Binding ToggleAssistantCommand}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="◌" FontSize="54" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding PluginSummary}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,14,0,6" />
                                        <TextBlock Text="开源核心可独立使用。接入助手插件后，这里将显示对话与知识检索能力。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                    <TextBox Grid.Row="2" IsEnabled="False" Text="智能服务未启用" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding GlobalStatus}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SelectedTab.GitStatus.Display}" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedTab.SyncText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="锁：无  │  自动：提示模式" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
