<Window x:Class="KBEA.App.Views.RecordListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记录" Width="900" Height="540" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <DataGrid x:Name="RecordsGrid" Grid.Row="1" AutoGenerateColumns="True" />
        <Button Grid.Row="2" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" />
    </Grid>
</Window>
