<Window x:Class="KBEA.App.Views.GitHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git 状态及历史" Width="960" Height="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />

        <!-- 上：Git 状态 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="仓库状态" FontWeight="SemiBold" FontSize="15" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
                    <TextBlock x:Name="BranchText" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChangeCountText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,0,0,0" />
                    <TextBlock x:Name="ConflictText" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="14,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="CompareButton" Content="⚖ 版本比对" Margin="14,0,0,0" Padding="10,3" Click="CompareButton_Click"
                            IsEnabled="False" ToolTip="对选中的冲突文件做 HEAD 基线与工作区的双屏比对，并可标记已解决" />
                </StackPanel>
                <DataGrid x:Name="StatusGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeight="26"
                          IsSynchronizedWithCurrentItem="False"
                          SelectionChanged="StatusGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="4,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="冲突">
                                            <Setter Property="Foreground" Value="#E05252" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="阶段" Binding="{Binding StagingText}" Width="80" />
                        <DataGridTextColumn Header="文件路径" Binding="{Binding RelativePath}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 下：版本历史 -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="版本历史" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                <DataGrid x:Name="HistoryGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeight="26"
                          IsSynchronizedWithCurrentItem="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="提交 SHA" Binding="{Binding Id}" Width="90" />
                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="120" />
                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Button Grid.Row="3" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" />
    </Grid>
</Window>
