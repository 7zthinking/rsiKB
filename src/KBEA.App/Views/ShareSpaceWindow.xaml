<Window x:Class="KBEA.App.Views.ShareSpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享空间到团队" Width="440" Height="250" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="16">
        <TextBlock Text="选择要共享的空间" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ComboBox x:Name="SpaceCombo" DisplayMemberPath="Name" Margin="0,0,0,14" />
        <TextBlock Text="团队成员的权限" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ComboBox x:Name="LevelCombo" SelectedIndex="1" Margin="0,0,0,14">
            <ComboBoxItem Content="可搜索（只进团队索引，不能取文件）" />
            <ComboBoxItem Content="可读取（可取回文件预览/打开）" />
            <ComboBoxItem Content="可编辑（可写回保存到本机）" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="共享" Style="{StaticResource ToolbarButton}" Click="OnShare" Width="80" />
            <Button Content="取消" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="OnCancel" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
