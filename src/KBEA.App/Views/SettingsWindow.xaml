<Window x:Class="KBEA.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号与设置" Width="720" Height="560" MinWidth="600" MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="16,18,12,14" />
                <ListBox x:Name="CategoryList" Grid.Row="1" SelectionChanged="CategoryList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Margin="6,0">
                    <ListBoxItem Content="个人信息" Tag="profile" />
                    <ListBoxItem Content="Git 与凭证" Tag="git" />
                    <ListBoxItem Content="外观与行为" Tag="appearance" />
                    <ListBoxItem Content="模型设置" Tag="model" />
                    <ListBoxItem Content="组织与共享" Tag="organization" />
                    <ListBoxItem Content="共享设置" Tag="sharing" />
                    <ListBoxItem Content="关于我们" Tag="about" />
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,22">
                <ContentControl x:Name="ContentHost" />
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource PanelBackground}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="88" IsCancel="True" Margin="0,0,10,0" />
                    <Button Content="保存设置" Width="100" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
