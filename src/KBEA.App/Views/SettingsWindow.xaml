<Window x:Class="KBEA.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号与设置" Width="650" Height="550" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="账号与设置" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Git 署名、归档路径与自动检测集中在这里配置。" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,20" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Git 账号" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Text="署名" />
                    <TextBox Grid.Column="1" Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="邮箱" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AuthorEmail, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Separator Margin="0,12" />
                <TextBlock Text="rsync 归档" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Text="rsync.exe" />
                    <TextBox x:Name="RsyncBox" Grid.Column="1" Text="{Binding RsyncExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="浏览" Click="BrowseRsync_Click" />
                    <TextBlock Grid.Row="1" Text="归档根目录" />
                    <TextBox x:Name="ArchiveBox" Grid.Row="1" Grid.Column="1" Text="{Binding ArchiveRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Row="1" Grid.Column="2" Content="浏览" Click="BrowseArchive_Click" />
                </Grid>
                <TextBlock Text="默认查找程序目录下的 tools/rsync/rsync.exe。绿色发布时请放入便携版。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8" />
                <Separator Margin="0,12" />
                <TextBlock Text="外观与行为" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <TextBlock Text="主题" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedItem="{Binding Theme, Mode=TwoWay}" HorizontalAlignment="Left" Width="160" />
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="监听文件变化并提示（默认不自动上传）" IsChecked="{Binding AutoDetect}" />
                </Grid>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="插件管理：启动时扫描程序目录 plugins/ 下的 plugin.json。无插件时，报表、项目管理和智能助手入口保持社区版壳状态。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="88" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="保存设置" Width="100" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
