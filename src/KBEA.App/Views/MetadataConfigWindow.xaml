<Window x:Class="KBEA.App.Views.MetadataConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="知识库元数据" Width="920" Height="660" MinWidth="760" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：后台服务状态 + 操作 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBackground}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="知识库元数据" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="WorkerStatusText" Margin="0,3,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="后台服务状态检测中…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="↻ 刷新" Style="{StaticResource ToolbarButton}"
                            Margin="0,0,8,0" Click="Refresh_Click" />
                    <Button x:Name="StartWorkerButton" Content="▶ 启动后台服务" Style="{StaticResource ToolbarButton}"
                            Click="StartWorker_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：整体概览 + 各库各层各插件明细 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
            <StackPanel>
                <!-- 整体情况 -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="整体情况" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverviewText" Margin="0,8,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Text="统计中…" />
                        <ProgressBar x:Name="OverviewBar" Height="5" Margin="0,10,0,0" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="SpacePanel" />
                <TextBlock x:Name="EmptyHint" Margin="0,40,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" Text="还没有知识库。请先在左侧创建一个知识库。" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：定时计划 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBackground}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="定时计划" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="ScheduleSpaceBox" Width="200" HorizontalAlignment="Left" SelectionChanged="ScheduleSpaceBox_SelectionChanged" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="每" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="IntervalBox" Width="56" Text="24" VerticalAlignment="Center" />
                    <TextBlock Text="小时执行" VerticalAlignment="Center" Margin="6,0,14,0" />
                    <ComboBox x:Name="ScheduleLevelBox" Width="110" SelectedIndex="0" />
                    <Button Content="添加计划" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="AddSchedule_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
