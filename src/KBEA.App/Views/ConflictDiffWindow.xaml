<Window x:Class="KBEA.App.Views.ConflictDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本比对" Width="1100" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <!-- 行级 diff 配色：绿=新增，红=删除，琥珀=修改冲突对，灰=对侧占位（多条件冲突判定放最后，优先生效） -->
        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LeftKind}" Value="Deleted">
                    <Setter Property="Background" Value="#48E05252" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LeftKind}" Value="Imaginary">
                    <Setter Property="Background" Value="#22FFFFFF" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding LeftKind}" Value="Deleted" />
                        <Condition Binding="{Binding RightKind}" Value="Inserted" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#59D9A13B" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RightKind}" Value="Inserted">
                    <Setter Property="Background" Value="#484CAF7D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RightKind}" Value="Imaginary">
                    <Setter Property="Background" Value="#22FFFFFF" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding LeftKind}" Value="Deleted" />
                        <Condition Binding="{Binding RightKind}" Value="Inserted" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#59D9A13B" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PrevDiffButton" Content="▲ 上一个差异" Style="{StaticResource ToolbarButton}" Click="PrevDiff_Click"
                        ToolTip="滚动定位到上一处差异（加载完成后可用）" IsEnabled="False" />
                <Button x:Name="NextDiffButton" Content="▼ 下一个差异" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="NextDiff_Click"
                        ToolTip="滚动定位到下一处差异（加载完成后可用）" IsEnabled="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚖ 版本比对 · " FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="FileText" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="HeadInfoText" Grid.Row="1" Margin="0,5,0,9" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />

        <!-- 加载中：窗口先显示，内容后台加载 -->
        <Border x:Name="LoadingPanel" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="⏳ 正在加载基线与差异…" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="240" Height="4" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- 双屏 diff（HEAD 基线 | 工作区），两列同步滚动；右列底层为彩色 diff 行、上层为透明编辑框 -->
        <Border x:Name="DiffPanel" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.ColumnSpan="3" Background="{DynamicResource SidebarBackground}" Padding="10,5">
                    <Grid>
                        <TextBlock Text="HEAD 基线（上次提交）" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Left" />
                        <TextBlock x:Name="RightHeaderText" Text="工作区（当前内容，可直接编辑）" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,14,0" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="LeftScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollChanged="DiffScrollChanged">
                    <ItemsControl x:Name="LeftList" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftText}" Style="{StaticResource LeftCellStyle}" FontFamily="Consolas" FontSize="12.5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Column="1" Grid.Row="1" Width="1" Background="{DynamicResource BorderBrush}" />
                <Grid Grid.Column="2" Grid.Row="1">
                    <ScrollViewer x:Name="RightScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" ScrollChanged="DiffScrollChanged">
                        <ItemsControl x:Name="RightList" ItemsSource="{Binding Rows}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RightText}" Style="{StaticResource RightCellStyle}" FontFamily="Consolas" FontSize="12.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 透明编辑层：颜色由底层行提供，文字/光标由这里承载；与底层同字体字号保证逐行对齐 -->
                    <TextBox x:Name="RightEdit" Background="Transparent" Foreground="Transparent" BorderThickness="0" Padding="0" Margin="0"
                             FontFamily="Consolas" FontSize="12.5" TextWrapping="NoWrap" AcceptsReturn="True" IsUndoEnabled="True"
                             CaretBrush="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                             VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                             TextChanged="RightEdit_TextChanged"
                             ScrollViewer.ScrollChanged="DiffScrollChanged" />
                </Grid>
            </Grid>
        </Border>

        <!-- 二进制文件：不支持文本 diff，给出处理选择 -->
        <Border x:Name="BinaryPanel" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="该文件是二进制内容，无法做文本双屏比对。" TextWrapping="Wrap" FontSize="14" />
                <TextBlock Text="可选择保留当前工作区版本，或还原为 HEAD 基线版本，然后标记冲突已解决。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- 操作区：直接编辑右栏内容；实时冲突检测通过后才允许保存解决 -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ResolveHint" Text="加载完成后：确认差异、直接在右栏修改内容，检测无冲突后即可保存并标记解决。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="KeepWorktreeButton" Content="保留工作区版本" Style="{StaticResource ToolbarButton}" Click="KeepWorktree_Click" ToolTip="直接以磁盘上的工作区内容作为解决结果" />
                    <Button x:Name="RevertHeadButton" Content="还原为 HEAD 版本" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="RevertHead_Click" ToolTip="放弃工作区改动，以 HEAD 基线作为解决结果" />
                    <Button x:Name="SaveResolvedButton" Content="保存并标记已解决" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="SaveResolved_Click" ToolTip="把右栏编辑后的文本写回文件，标记冲突已解决并提交" />
                    <Button Content="关闭" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
