<Window x:Class="KBEA.App.Views.LanDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网诊断" Width="640" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="mDNS 发现链路诊断" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
            <TextBlock x:Name="SelfInfoText" Grid.Row="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Text="读取中…" />
            <TextBlock x:Name="StatsText" Grid.Row="2" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="—" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="发现的设备" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding Nickname, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding OnlineText, Mode=OneWay}" Foreground="{Binding OnlineBrush, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding DetailText}" Margin="0,3,0,0" />
                                    <TextBlock Foreground="{Binding PortBrush, Mode=OneWay}" FontSize="12" Margin="0,3,0,0"
                                               Text="{Binding PortStatusText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoDeviceText" Text="（暂无发现——见上方应答统计）" Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />

                <TextBlock Text="本机网卡（IP / 网关）" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,6" />
                <ItemsControl x:Name="InterfaceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="重新扫描" Style="{StaticResource ToolbarButton}" Click="OnRescan" Margin="0,0,8,0" />
                <Button Content="重测端口" Style="{StaticResource ToolbarButton}" Click="OnRetest" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
