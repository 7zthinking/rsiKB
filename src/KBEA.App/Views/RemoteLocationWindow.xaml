<Window x:Class="KBEA.App.Views.RemoteLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加远程目录" Width="640" Height="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="添加远程目录" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="保存 Git、rsync 或网络位置，便于浏览和挂接到工作空间。" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="50"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                <TextBlock Text="类型" />
                <ComboBox x:Name="KindBox" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="Git 仓库" />
                    <ComboBoxItem Content="rsync 目录" />
                    <ComboBoxItem Content="网络位置（UNC）" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="显示名称" />
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="远程地址" />
                <TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Text="本地副本 / 缓存" />
                <TextBox x:Name="LocalPathBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Row="3" Grid.Column="2" Content="浏览" Click="Browse_Click" />
            </Grid>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Git 留空缓存时，首次打开会克隆；rsync 使用所选缓存目录；网络位置直接填写 \\服务器\共享目录，本地缓存可留空。" />
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="88" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="保存" Width="96" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
