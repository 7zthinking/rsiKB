<Window x:Class="KBEA.App.Views.SpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建空间" Width="640" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Text="新建空间" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="Description" Text="一个空间对应一个物理位置：本地文件夹、Git 仓库、rsync 目录或网络位置。" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,20" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="空间名称" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBox x:Name="NameBox" FontSize="14" Padding="10,8" TextChanged="NameBox_TextChanged" />

            <TextBlock Text="物理位置" FontWeight="SemiBold" Margin="0,18,0,7" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource PanelBackground}" Padding="10,8">
                    <TextBlock x:Name="FolderPathText" Text="尚未选择位置" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button x:Name="SelectFolderButton" Grid.Column="1" Content="选择文件夹" Margin="8,0,0,0" Click="SelectFolder_Click" />
            </Grid>

            <StackPanel x:Name="RemoteOptions" Margin="0,16,0,0">
                <TextBlock Text="远程地址（可选）" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="RemoteKindBox" Grid.Column="0" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="RemoteKindBox_SelectionChanged">
                        <ComboBoxItem Content="Git 仓库" />
                        <ComboBoxItem Content="rsync 目录" />
                        <ComboBoxItem Content="网络位置" />
                    </ComboBox>
                    <TextBox x:Name="RemoteUrlBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="RemoteHintText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel x:Name="DirectoryOptions" Margin="0,18,0,0">
                <TextBlock Text="归属目录（可选）" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ComboBox x:Name="DirectoryBox" HorizontalAlignment="Stretch" />
                <TextBlock Text="目录用于把空间逻辑归类，例如“项目”“专业”“阶段”。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel x:Name="GitOptions" Margin="0,16,0,0">
                <Button x:Name="GitButton" Content="关联 Git 仓库" HorizontalAlignment="Left" Click="Git_Click" />
                <TextBlock x:Name="GitInfoText" Text="选择位置后可查看或关联 Git 仓库。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,9,0,0" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Button x:Name="DeleteButton" Content="删除空间" HorizontalAlignment="Left" Foreground="{DynamicResource WarningBrush}" Background="Transparent" Visibility="Collapsed" Click="Delete_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="88" IsCancel="True" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="创建空间" Width="104" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
