<Window x:Class="KBEA.App.Views.GitOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git 命令输出" Width="780" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0：标题 + 副标题 + 右侧彩色状态 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ResultStatus" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="SubText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Row 1：命令输出面板（上对齐，内容多了自动滚动） -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Segoe UI Mono"
                     FontSize="12"
                     Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     Padding="10,8"
                     BorderThickness="0"
                     VerticalAlignment="Top"
                     Text="" />
        </Border>

        <!-- Row 2：底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Content="复制全部" Width="96" Margin="0,0,10,0" Click="Copy_Click" />
            <Button x:Name="CloseButton" Content="关闭" Width="88" IsCancel="True" Click="Close_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
