<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>KBEA</AssemblyName>
    <RootNamespace>KBEA.App</RootNamespace>
    <Description>知识库自进化助手开源版</Description>
    <SingleAssembly Condition="'$(SingleAssembly)' == ''">false</SingleAssembly>
    <!-- Windows 任务栏 / 资源管理器 / Alt-Tab 图标 -->
    <!-- exe 图标：publish.ps1 会把 branding/logo.png 生成为 artifacts/branding/branding-app.ico，
         存在时嵌入 exe（文件资源管理器/任务栏默认图标）；本地开发无生成物时回落内置 app.ico -->
    <ApplicationIcon Condition="Exists('..\..\artifacts\branding\branding-app.ico')">..\..\artifacts\branding\branding-app.ico</ApplicationIcon>
    <ApplicationIcon Condition="!Exists('..\..\artifacts\branding\branding-app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 团队共享：Kestrel HTTP + WebDAV 服务（承载于 App 进程） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(SingleAssembly)' != 'true'">
    <ProjectReference Include="..\KBEA.Core\KBEA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <Resource Include="Assets\logo.png" />
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- 品牌固化配置（branding/branding.yaml）解析 -->
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <!-- Optional single-assembly source run for devices with application-control
       policies that block newly built, unsigned dependency DLLs. -->
  <ItemGroup Condition="'$(SingleAssembly)' == 'true'">
    <Compile Include="..\KBEA.Core\**\*.cs" Exclude="..\KBEA.Core\obj\**\*;..\KBEA.Core\bin\**\*" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

</Project>
