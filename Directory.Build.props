<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>KBEA Contributors</Authors>
    <Product>知识库自进化助手</Product>
  </PropertyGroup>

  <!-- 应用版本：全仓库唯一真相源。
       所有项目继承这里的 <Version>；UI 显示、插件 minHostVersion 兼容判断、
       「检查更新」都读程序集里的这个值（见 src/KBEA.Core/Versioning/AppVersion.cs）。

       发版流程（Tag 驱动，CI 以 tag 版本为准）：
         git tag vX.Y.Z && git push origin vX.Y.Z
       → CI 用 tag 版本号构建并自动创建 GitHub Release（覆盖这里的值）。
       这里的 <Version> 是本地开发默认版本，开发期随手跟进到下一版即可。 -->
  <PropertyGroup>
    <Version>0.5.1</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>
</Project>
