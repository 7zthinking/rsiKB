<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Compile the same core sources into the test host. This also supports
       Windows devices whose application-control policy blocks new unsigned DLLs.
       P2：GitService/GitCli 实现已迁入 kbea-plugin-git，这里以源码方式一并编入
       （GitServiceTests 直接测实现；LibGit2Sharp 由本项目的 PackageReference 提供）。 -->
  <ItemGroup>
    <Compile Include="..\..\src\KBEA.Core\**\*.cs"
             Exclude="..\..\src\KBEA.Core\obj\**\*;..\..\src\KBEA.Core\bin\**\*"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\KBEA.Plugin.Git\GitService.cs;..\..\src\KBEA.Plugin.Git\GitCli.cs"
             Link="Core\%(Filename)%(Extension)" />
    <!-- rsync 归档已迁入 kbea-plugin-rsync：归档存储实现以源码方式编入以便单测 -->
    <Compile Include="..\..\src\KBEA.Plugin.Rsync\ArchiveStore.cs"
             Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
